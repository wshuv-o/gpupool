# Default: let git normalise text in the repo, check out native on each OS.
* text=auto

# These run on Linux. A CRLF shebang makes the kernel look for an interpreter
# literally named "bash\r", which fails as "bad interpreter: No such file or
# directory" — an error that says nothing about line endings.
*.sh            text eol=lf
*.service       text eol=lf
*.conf          text eol=lf
Dockerfile      text eol=lf
deploy/**       text eol=lf

# Keeps diffs honest for files that are byte-sensitive.
*.png           binary
*.ico           binary
